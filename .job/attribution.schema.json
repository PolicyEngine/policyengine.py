{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:policyengine:uk-a133f37a-attribution:1",
  "title": "Same-line national UK 2x2 attribution receipt",
  "type": "object",
  "required": ["schema_version", "purpose", "synthetic_fixture", "years", "models", "cuts", "definitions", "history", "cells", "effects", "interactions", "unavailable_effects", "unattributed", "limitations", "scorecard_replay", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "purpose": {"type": "string"},
    "synthetic_fixture": {"type": "boolean"},
    "years": {"const": [2026, 2027, 2028, 2029, 2030]},
    "models": {"const": {"old": "2.132.6", "new": "2.147.2"}},
    "cuts": {"type": "object", "required": ["old", "new"]},
    "definitions": {"type": "object", "required": ["flags", "heads", "poverty"]},
    "history": {"type": "object", "required": ["model", "data"]},
    "cells": {
      "type": "object",
      "required": ["old_data__old_model", "old_data__new_model", "new_data__old_model", "new_data__new_model"],
      "additionalProperties": {"$ref": "#/$defs/cell"},
      "minProperties": 4,
      "maxProperties": 4
    },
    "effects": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "unattributed": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
    "unavailable_effects": {"type": "array"},
    "interactions": {"type": "array", "items": {"type": "object", "required": ["metric_id", "year", "value", "definition"], "properties": {"value": {"type": ["number", "null"]}}}},
    "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "scorecard_replay": {"type": "object", "required": ["status", "reason"], "properties": {"status": {"const": "unavailable"}}},
    "summary": {"type": "object", "required": ["cells_computable", "flagged_moves", "unattributed_moves"]}
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": ["id", "status", "metrics", "error"],
      "properties": {
        "id": {"type": "string"},
        "status": {"enum": ["computable", "not_computable"]},
        "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
        "error": {"type": ["object", "null"]}
      }
    },
    "metric": {
      "type": "object", "required": ["id", "variable", "kind", "year", "value", "status", "error"],
      "properties": {
        "id": {"type": "string"}, "variable": {"type": "string"},
        "kind": {"enum": ["gbp", "count", "rate"]},
        "year": {"enum": [2026, 2027, 2028, 2029, 2030]},
        "value": {"type": ["number", "null"]},
        "status": {"enum": ["ok", "suppressed", "not_computable"]},
        "error": {"type": ["object", "null"]}
      }
    },
    "effect": {
      "type": "object", "required": ["metric_id", "year", "effect", "status", "base_cell", "head_cell", "base", "head", "delta", "threshold", "flagged", "reasons"],
      "properties": {
        "metric_id": {"type": "string"},
        "year": {"enum": [2026, 2027, 2028, 2029, 2030]},
        "effect": {"enum": ["model_on_old_data", "model_on_new_data", "data_on_old_model", "data_on_new_model", "total_change"]},
        "status": {"enum": ["computable", "not_computable"]},
        "base": {"type": ["number", "null"]}, "head": {"type": ["number", "null"]},
        "delta": {"type": ["number", "null"]}, "threshold": {"type": ["number", "null"]},
        "flagged": {"type": "boolean"}, "reasons": {"type": "array", "items": {"type": "string"}},
        "attribution": {"type": "object", "required": ["status", "reviewed_mappings", "candidate_causes", "unmapped_components"], "properties": {"status": {"enum": ["attributed", "unattributed"]}}}
      }
    }
  }
}
