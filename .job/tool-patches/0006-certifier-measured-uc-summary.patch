From: Budget rehearsal <budget-rehearsal@localhost>
Date: Fri, 23 Oct 2026 08:16:44 -0400
Subject: [PATCH] Report measured UC floor status and request acceptance only
 for failures

---
 .../test_certify_uk_cut_in_policyengine_py.py | 45 ++++++++++++-
 tools/certify_uk_cut_in_policyengine_py.py    | 67 +++++++++++++------
 2 files changed, 91 insertions(+), 21 deletions(-)

diff --git a/tests/test_certify_uk_cut_in_policyengine_py.py b/tests/test_certify_uk_cut_in_policyengine_py.py
index 66a6e4d..6a7acc9 100644
--- a/tests/test_certify_uk_cut_in_policyengine_py.py
+++ b/tests/test_certify_uk_cut_in_policyengine_py.py
@@ -310,6 +310,15 @@ class RunnerTests(unittest.TestCase):
     def run_mock_pipeline(
         self, *, pytest_code=0, uc_code=0, receipt=None, call_details=None
     ):
+        if receipt is None and uc_code == 0:
+            receipt = {
+                "check": "uk_uc_floor",
+                "passed": True,
+                "measures": [
+                    {"name": "benefit_units", "ratio": 0.92524521, "passed": True},
+                    {"name": "spend", "ratio": 0.95781282, "passed": True},
+                ],
+            }
         tmp = tempfile.TemporaryDirectory()
         self.addCleanup(tmp.cleanup)
         root = Path(tmp.name)
@@ -394,13 +403,47 @@ class RunnerTests(unittest.TestCase):
             receipt={
                 "check": "uk_uc_floor",
                 "passed": False,
-                "measures": [{"name": "spend", "passed": False}],
+                "measures": [
+                    {"name": "benefit_units", "ratio": 0.8, "passed": False},
+                    {"name": "spend", "ratio": 0.95, "passed": True},
+                ],
             },
         )
         self.assertEqual(result, 0)
         self.assertIn(
             "UC floor acceptance", (root / "certification.pr-body.md").read_text()
         )
+        self.assertIn(
+            "FAILED; measured/benchmark ratios: benefit_units=0.800000, spend=0.950000",
+            (root / "certification.pr-body.md").read_text(),
+        )
+
+    def test_passed_uc_floor_reports_ratios_without_acceptance_request(self):
+        result, _, root = self.run_mock_pipeline()
+        self.assertEqual(result, 0)
+        body = (root / "certification.pr-body.md").read_text()
+        self.assertIn(
+            "passed; measured/benchmark ratios: benefit_units=0.925245, spend=0.957813",
+            body,
+        )
+        self.assertNotIn("UC floor acceptance", body)
+
+    def test_incomplete_uc_floor_receipt_refuses_even_after_zero_exit(self):
+        with self.assertRaisesRegex(runner.CertifyError, "failed operationally"):
+            self.run_mock_pipeline(receipt={})
+
+    def test_uc_floor_rejects_contradictory_measure_status(self):
+        with self.assertRaisesRegex(runner.CertifyError, "failed operationally"):
+            self.run_mock_pipeline(
+                receipt={
+                    "check": "uk_uc_floor",
+                    "passed": True,
+                    "measures": [
+                        {"name": "benefit_units", "ratio": 0.8, "passed": False},
+                        {"name": "spend", "ratio": 0.95, "passed": True},
+                    ],
+                }
+            )
 
     def test_handoff_marks_wrapper_qualification_pending(self):
         _, _, root = self.run_mock_pipeline()
diff --git a/tools/certify_uk_cut_in_policyengine_py.py b/tools/certify_uk_cut_in_policyengine_py.py
index c2bc0fd..8a93949 100644
--- a/tools/certify_uk_cut_in_policyengine_py.py
+++ b/tools/certify_uk_cut_in_policyengine_py.py
@@ -44,6 +44,7 @@ from __future__ import annotations
 
 import argparse
 import json
+import math
 import os
 import re
 import shlex
@@ -432,6 +433,33 @@ def overlay_diff(old_bundle: dict, new_bundle: dict) -> list[str]:
     return sorted(old - new)
 
 
+def uc_floor_summary(receipt: dict[str, Any]) -> str:
+    """Summarize a complete measured floor without truncating its JSON receipt."""
+    measures = receipt.get("measures") or []
+    if (
+        receipt.get("check") != "uk_uc_floor"
+        or not isinstance(receipt.get("passed"), bool)
+        or not {"benefit_units", "spend"}.issubset(
+            {measure.get("name") for measure in measures}
+        )
+        or any(
+            not isinstance(measure.get("passed"), bool)
+            or not isinstance(measure.get("ratio"), (int, float))
+            or not math.isfinite(measure["ratio"])
+            for measure in measures
+        )
+        or receipt["passed"] != all(measure["passed"] for measure in measures)
+    ):
+        raise CertifyError(
+            "UC floor failed operationally: incomplete measured receipt."
+        )
+    status = "passed" if receipt["passed"] else "FAILED"
+    ratios = ", ".join(
+        f"{measure['name']}={measure['ratio']:.6f}" for measure in measures
+    )
+    return f"{status}; measured/benchmark ratios: {ratios}"
+
+
 def pr_body(context: dict[str, Any]) -> str:
     lines = [
         f"Certifies Microcosm UK national cut `{context['national_tag']}` "
@@ -468,10 +496,13 @@ def pr_body(context: dict[str, Any]) -> str:
         "evidence. Keep qualification pending until the evidence is reviewed. "
         "Record any explicit reviewer-approved exception; this script waives "
         "no gate.",
-        "- [ ] **UC floor acceptance.** A later Microcosm cut with the same gap "
-        "needs the same explicit acceptance in its pull request "
-        "(data-certification.md, recorded exceptions). Accepted by: ___",
     ]
+    if (context.get("uc_floor_receipt") or {}).get("passed") is False:
+        lines.append(
+            "- [ ] **UC floor acceptance.** This cut has a measured floor failure "
+            "and needs explicit acceptance in its pull request "
+            "(data-certification.md, recorded exceptions). Accepted by: ___"
+        )
     if context.get("dropped_overlays"):
         lines.append(
             "- [ ] **Dataset overlays dropped by certification:** "
@@ -770,28 +801,23 @@ def certify(args: argparse.Namespace) -> int:
         step="UC-floor",
         env={"POLICYENGINE_SKIP_COUNTRY_IMPORTS": "1"},
     )  # fmt: skip
-    if uc.returncode and not uc_path.exists():
+    if not uc_path.exists():
         raise CertifyError(
             f"UC floor failed operationally (exit {uc.returncode}); no measured "
             f"receipt was produced. See {log}."
         )
-    if uc_path.exists():
+    try:
         receipt = json.loads(uc_path.read_text())
-        if uc.returncode and not (
-            uc.returncode == 1
-            and receipt.get("check") == "uk_uc_floor"
-            and receipt.get("passed") is False
-            and receipt.get("measures")
-        ):
-            raise CertifyError(
-                f"UC floor failed operationally (exit {uc.returncode}); "
-                "the receipt is not a measured floor violation."
-            )
-    uc_summary = (
-        uc_path.read_text().strip()[:600]
-        if uc_path.exists()
-        else f"exit {uc.returncode}"
-    )
+        uc_summary = uc_floor_summary(receipt)
+    except (json.JSONDecodeError, AttributeError, TypeError) as error:
+        raise CertifyError(
+            "UC floor failed operationally: invalid measured receipt."
+        ) from error
+    if uc.returncode != (0 if receipt["passed"] else 1):
+        raise CertifyError(
+            f"UC floor failed operationally (exit {uc.returncode}); "
+            "the measured receipt disagrees with the process exit status."
+        )
     tests_summary, tests_failed, tests_returncode = "skipped", [], 0
     if not args.skip_tests:
         xdist = run(
@@ -822,6 +848,7 @@ def certify(args: argparse.Namespace) -> int:
         "microcosm_commit": microcosm_commit,
         "commands": run.commands,
         "uc_floor": f"`{uc_summary}`",
+        "uc_floor_receipt": receipt,
         "tests": tests_summary,
         "tests_failed": tests_failed,
         "constants": ", ".join(constants),
