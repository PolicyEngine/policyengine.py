From c9f4f460dd53e86d1cc3708255d0b33e864350a1 Mon Sep 17 00:00:00 2001
From: Budget rehearsal <budget-rehearsal@localhost>
Date: Fri, 23 Oct 2026 09:21:32 -0400
Subject: [PATCH] Refuse full-suite fixtures nested inside a Git repository
 before heavy work

---
 ...st_certify_uk_cut_rehearsal_regressions.py | 74 +++++++++++++++++++
 tools/certify_uk_cut_in_policyengine_py.py    | 21 ++++++
 2 files changed, 95 insertions(+)

diff --git a/packages/microcosm-build/tests/engine_free/uk/test_certify_uk_cut_rehearsal_regressions.py b/packages/microcosm-build/tests/engine_free/uk/test_certify_uk_cut_rehearsal_regressions.py
index 5b4fef5..15188f9 100644
--- a/packages/microcosm-build/tests/engine_free/uk/test_certify_uk_cut_rehearsal_regressions.py
+++ b/packages/microcosm-build/tests/engine_free/uk/test_certify_uk_cut_rehearsal_regressions.py
@@ -135,6 +135,75 @@ class RunnerTests(unittest.TestCase):
                 runner.model_surface("2.147.2")
             spawn.assert_not_called()
 
+    def test_temp_preflight_rejects_git_directory_or_worktree_file(self):
+        for marker_is_directory in (True, False):
+            with self.subTest(marker_is_directory=marker_is_directory):
+                with tempfile.TemporaryDirectory() as tmp:
+                    repository = Path(tmp) / "repository"
+                    repository.mkdir()
+                    marker = repository / ".git"
+                    if marker_is_directory:
+                        marker.mkdir()
+                    else:
+                        marker.write_text("gitdir: /unused/worktree-metadata\n")
+                    directory = repository / "private-temp"
+                    directory.mkdir()
+                    with self.assertRaisesRegex(
+                        runner.CertifyError, "Set TMPDIR.*outside every Git"
+                    ) as refusal:
+                        runner.check_test_temp_directory(directory)
+                    self.assertIn(str(repository), str(refusal.exception))
+
+    def test_temp_preflight_resolves_symlinks_before_checking_ancestors(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            repository = Path(tmp) / "repository"
+            repository.mkdir()
+            (repository / ".git").mkdir()
+            directory = repository / "private-temp"
+            directory.mkdir()
+            alias = Path(tmp) / "alias"
+            alias.symlink_to(directory, target_is_directory=True)
+            with self.assertRaisesRegex(runner.CertifyError, "inside Git"):
+                runner.check_test_temp_directory(alias)
+
+    def test_temp_preflight_accepts_an_outside_git_location_without_writing(self):
+        external = Path("/external-private-temp")
+        with (
+            patch.object(runner.tempfile, "gettempdir", return_value=str(external)),
+            patch.object(Path, "exists", return_value=False),
+        ):
+            self.assertEqual(runner.check_test_temp_directory(), external)
+
+    def test_temp_preflight_refuses_before_network_or_model_work(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            args = runner.parse(
+                [
+                    "--national-tag",
+                    TAG,
+                    "--drop-regional-release",
+                    "--pepy-repo",
+                    tmp,
+                ]
+            )
+            with (
+                patch.object(
+                    runner.subprocess, "check_output", return_value="microcosm"
+                ),
+                patch.object(
+                    runner,
+                    "check_test_temp_directory",
+                    side_effect=runner.CertifyError("temporary directory inside Git"),
+                ),
+                patch.object(runner, "read_cut") as manifest,
+                patch.object(runner, "model_surface") as surface,
+                patch.object(runner.subprocess, "run") as spawn,
+            ):
+                with self.assertRaisesRegex(runner.CertifyError, "inside Git"):
+                    runner.certify(args)
+            manifest.assert_not_called()
+            surface.assert_not_called()
+            spawn.assert_not_called()
+
     def test_model_surface_pins_core_and_records_intended_pair(self):
         surface = {"all": ["x"], "inputs": ["x"]}
         with tempfile.TemporaryDirectory() as tmp:
@@ -374,6 +443,11 @@ class RunnerTests(unittest.TestCase):
                 return_value=runner.CutVersions(TAG, "2.147.2", "3.0", ()),
             ),
             patch.object(runner.Shell, "__call__", side_effect=shell),
+            patch.object(
+                runner,
+                "check_test_temp_directory",
+                return_value=root / "isolated-test-temp",
+            ),
         ):
             result = runner.certify(args)
         return result, calls, root
diff --git a/tools/certify_uk_cut_in_policyengine_py.py b/tools/certify_uk_cut_in_policyengine_py.py
index 346adba..f169c37 100644
--- a/tools/certify_uk_cut_in_policyengine_py.py
+++ b/tools/certify_uk_cut_in_policyengine_py.py
@@ -51,6 +51,7 @@ import shlex
 import shutil
 import subprocess
 import sys
+import tempfile
 import time
 from contextlib import contextmanager
 from dataclasses import dataclass
@@ -181,6 +182,23 @@ def resource_guard(root: Path) -> dict[str, float | int]:
     return {"load1": load1, "free_bytes": free}
 
 
+def check_test_temp_directory(directory: Path | None = None) -> Path:
+    """Refuse a full suite whose temporary fixtures inherit an ancestor Git repo."""
+    directory = Path(directory or tempfile.gettempdir()).expanduser().resolve()
+    for ancestor in (directory, *directory.parents):
+        if (ancestor / ".git").exists():
+            raise CertifyError(
+                f"Full-suite temporary directory {directory} is inside Git "
+                f"repository {ancestor}. Version fixtures would inherit its tags "
+                "and private disclosure audit fixtures correctly refuse Git paths. "
+                "Set TMPDIR to a private writable directory outside every Git "
+                "repository before certification. If workspace-only execution "
+                "prevents that, report full-suite validation blocked; --skip-tests "
+                "records a mechanical handoff only and does not qualify the cut."
+            )
+    return directory
+
+
 def record_timing(path: Path, record: dict[str, Any]) -> None:
     path.parent.mkdir(parents=True, exist_ok=True)
     with path.open("a") as handle:
@@ -609,6 +627,9 @@ def certify(args: argparse.Namespace) -> int:
     worktree = args.worktree or repo.parent / "_worktrees" / f"pepy-{branch}"
     log = worktree.parent / f"{worktree.name}.certify.log"
     timings = log.with_suffix(".timings.jsonl")
+    if not args.skip_tests and not args.dry_run:
+        with timed_step("test-temp-preflight", timings) as timing:
+            timing["temporary_directory"] = str(check_test_temp_directory())
     base_ref = args.base_ref
     if base_ref.startswith("origin/"):
         remote_branch = base_ref.removeprefix("origin/")
