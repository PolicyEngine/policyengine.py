{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://github.com/PolicyEngine/policyengine-scorecard/blob/main/docs/uk_replay/schemas/replay_status.v1.json",
 "title": "UK fiscal-event replay request status, v1",
 "description": "replay-state:requests/<request_id>/STATUS.json. A terminal status names the receipt's digest and the replay-state commit that added REPLAY_RECEIPT.json, so one contents read binds the status to the receipt bytes.",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema", "request_id", "status", "history"],
 "properties": {
  "schema": {"const": "policyengine.uk-replay-status/v1"},
  "request_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "status": {"enum": ["queued", "running", "complete", "rejected", "failed"]},
  "history": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["status", "at", "run_url"],
    "properties": {
     "status": {"enum": ["queued", "running", "complete", "rejected", "failed"]},
     "at": {"type": "string", "format": "date-time"},
     "run_url": {"type": "string", "pattern": "^https://github\\.com/PolicyEngine/policyengine-scorecard/actions/runs/[0-9]+"}
    }
   }
  },
  "receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
  "receipt_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
 },
 "allOf": [
  {
   "if": {"properties": {"status": {"enum": ["complete", "rejected", "failed"]}}},
   "then": {"required": ["receipt_sha256", "receipt_commit"]}
  }
 ]
}
